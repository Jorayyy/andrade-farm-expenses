generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Expense {
  id            String   @id @default(cuid())
  date          DateTime
  description   String
  amount        Decimal  @db.Decimal(12, 2)
  category      String
  vendor        String?
  paymentMethod String?
  notes         String?
  receiptId     String?
  receipt       Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  paddyId       String?
  paddy         Paddy?   @relation(fields: [paddyId], references: [id], onDelete: SetNull)
  seasonId      String?
  season        Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([paddyId])
  @@index([seasonId])
}

model Receipt {
  id        String    @id @default(cuid())
  filename  String
  mimeType  String
  data      String
  size      Int
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model InventoryItem {
  id           String          @id @default(cuid())
  name         String
  category     String
  unit         String
  quantity     Float           @default(0)
  reorderLevel Float           @default(0)
  unitCost     Decimal         @default(0) @db.Decimal(12, 2)
  location     String?
  notes        String?
  movements    StockMovement[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category])
}

model StockMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String
  quantity  Float
  date      DateTime      @default(now())
  note      String?
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@index([date])
}

model Income {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  buyer       String?
  notes       String?
  paddyId     String?
  paddy       Paddy?   @relation(fields: [paddyId], references: [id], onDelete: SetNull)
  seasonId    String?
  season      Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([paddyId])
  @@index([seasonId])
}

model Livestock {
  id             String    @id @default(cuid())
  tag            String
  species        String
  breed          String?
  sex            String?
  birthDate      DateTime?
  acquiredDate   DateTime?
  acquisitionCost Decimal? @db.Decimal(12, 2)
  status         String    @default("Active")
  location       String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([species])
  @@index([status])
}

model Crop {
  id                   String    @id @default(cuid())
  name                 String
  variety              String?
  plot                 String?
  area                 Float?
  areaUnit             String?   @default("ha")
  plantedDate          DateTime?
  expectedHarvestDate  DateTime?
  status               String    @default("Growing")
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Rice paddy management
// ---------------------------------------------------------------------------

model Paddy {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  areaHa          Decimal  @db.Decimal(10, 4)
  lengthM         Float?
  widthM          Float?
  soilType        String?
  irrigationType  String   @default("Irrigated")
  waterSource     String?
  elevationM      Float?
  latitude        Float?
  longitude       Float?
  status          String   @default("Active")
  notes           String?
  seasons         Season[]
  waterLogs       WaterLog[]
  operations      FieldOperation[]
  issues          FieldIssue[]
  tasks           Task[]
  expenses        Expense[]
  incomes         Income[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([irrigationType])
}

model RiceVariety {
  id                String   @id @default(cuid())
  name              String   @unique
  ecosystem         String   @default("Irrigated")
  maturityDays      Int
  potentialYieldTha Decimal  @db.Decimal(6, 2)
  seedRateKgHa      Float    @default(40)
  nRequirementKgHa  Float    @default(120)
  blastResistance   String?
  bphResistance     String?
  notes             String?
  seasons           Season[]
  createdAt         DateTime @default(now())
}

model Season {
  id                  String        @id @default(cuid())
  paddyId             String
  paddy               Paddy         @relation(fields: [paddyId], references: [id], onDelete: Cascade)
  varietyId           String?
  variety             RiceVariety?  @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  label               String
  seasonType          String        @default("Wet")
  method              String        @default("Transplanted")
  status              String        @default("Planned")
  nurseryDate         DateTime?
  plantingDate        DateTime?
  expectedHarvestDate DateTime?
  harvestDate         DateTime?
  seedRateKgHa        Float?
  targetYieldTha      Decimal?      @db.Decimal(6, 2)
  actualYieldKg       Decimal?      @db.Decimal(12, 2)
  grainMoisturePct    Float?
  pricePerKg          Decimal?      @db.Decimal(8, 2)
  nAppliedKg          Float?
  pAppliedKg          Float?
  kAppliedKg          Float?
  notes               String?
  waterLogs           WaterLog[]
  operations          FieldOperation[]
  issues              FieldIssue[]
  tasks               Task[]
  expenses            Expense[]
  incomes             Income[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([paddyId])
  @@index([status])
  @@index([plantingDate])
}

model WaterLog {
  id            String   @id @default(cuid())
  paddyId       String
  paddy         Paddy    @relation(fields: [paddyId], references: [id], onDelete: Cascade)
  seasonId      String?
  season        Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  date          DateTime
  waterDepthCm  Float?
  irrigationMm  Float    @default(0)
  rainfallMm    Float    @default(0)
  drainageMm    Float    @default(0)
  note          String?
  createdAt     DateTime @default(now())

  @@index([paddyId, date])
  @@index([seasonId])
}

model FieldOperation {
  id          String   @id @default(cuid())
  paddyId     String
  paddy       Paddy    @relation(fields: [paddyId], references: [id], onDelete: Cascade)
  seasonId    String?
  season      Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  date        DateTime
  type        String
  description String
  quantity    Float?
  unit        String?
  cost        Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([paddyId, date])
  @@index([seasonId])
  @@index([type])
}

model FieldIssue {
  id          String   @id @default(cuid())
  paddyId     String
  paddy       Paddy    @relation(fields: [paddyId], references: [id], onDelete: Cascade)
  seasonId    String?
  season      Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  date        DateTime
  type        String
  name        String
  severity    Int      @default(1)
  affectedPct Float?
  treatment   String?
  resolved    Boolean  @default(false)
  resolvedDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([paddyId, date])
  @@index([seasonId])
}

model Task {
  id          String   @id @default(cuid())
  paddyId     String?
  paddy       Paddy?   @relation(fields: [paddyId], references: [id], onDelete: Cascade)
  seasonId    String?
  season      Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  title       String
  type        String   @default("Other")
  dueDate     DateTime
  priority    String   @default("Normal")
  status      String   @default("Open")
  notes       String?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([dueDate])
  @@index([status])
  @@index([paddyId])
}
