# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct connection string used by Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Shared farm password (required). Use a long random value.
AUTH_PASSWORD="change-me-to-a-long-random-password"

# Signs the login cookie (required, 32+ characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET="change-me-to-at-least-32-random-characters"

# Keeps "this month" and date-only records on Philippine farm time.
TZ="Asia/Manila"

# Optional default farm coordinates for Open-Meteo weather.
# Set coordinates on a paddy to override these.
FARM_LAT="15.486"
FARM_LNG="120.973"
